# Destination for published site files.
# Override: `just DEST=/path/to/out copy`
DEST := "../ghelobytes.github.io/cross-canada/"

# Local static server port. Override: `just PORT=9000 serve`
PORT := "8765"

# Serve the site locally (http://localhost:{{PORT}})
serve:
    @echo "Serving at http://localhost:{{PORT}}"
    python3 -m http.server {{PORT}}

# Copy everything into DEST except the .cursor/ folder.
copy:
    #!/usr/bin/env bash
    set -euo pipefail
    dest="{{DEST}}"
    mkdir -p "$dest"
    excludes=(--exclude '.cursor' --exclude '.cursor/**')
    # Avoid copying DEST into itself when it lives under this repo.
    if [[ "$dest" != /* ]]; then
      rel="${dest#./}"
      rel="${rel%/}"
      excludes+=(--exclude "$rel" --exclude "$rel/**")
    fi
    rsync -a "${excludes[@]}" ./ "$dest/"
    echo "Copied to $dest"
